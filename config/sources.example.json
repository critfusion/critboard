{
  "_readme": "Copy of the defaults used to seed config/sources.json on first run. This file IS tracked in git; config/sources.json is NOT (see .gitignore) -- it holds machine-local paths and hostnames and is generated from this file automatically the first time the dashboard starts. Edit config/sources.json directly for your own machine; edit this file only if you want to change what a fresh install starts with.",
  "beads_env": "~/.config/beads/env",
  "beads_actor": "critdash",
  "bd_bin": "~/.local/bin/bd",
  "herdr_bin": "herdr",
  "claude_projects_dir": "~/.claude/projects",
  "kimi_dir": "~/.kimi-code",
  "overlord_dir": "~/.overlord",
  "repo_roots": [
    "~/repos",
    "~/src",
    "~/work"
  ],
  "db_path": "server/data/critdash.db",
  "intervals_s": {
    "beads": 30,
    "agents": 5,
    "worktrees": 60,
    "usage": 10,
    "kimi": 10,
    "dispatch": 30,
    "system": 15,
    "analytics": 90,
    "productivity": 600
  },
  "excluded_repos": [],
  "worktree_worker_pool": 32,
  "worktree_git_timeout_s": 5,
  "repo_scan_depth": 4,
  "worktree_skip_dirs": [
    "node_modules",
    ".venv",
    "venv",
    "vendor",
    "site-packages",
    ".cache",
    ".pub-cache",
    "build",
    "dist",
    "target",
    ".tox",
    ".gradle"
  ],
  "host": "localhost",
  "bind_host": "127.0.0.1",
  "bind_port": 9999,
  "hosts": [
    {"name": "localhost", "mode": "local", "enabled": true}
  ],
  "session_active_window_s": 900,
  "remote_interval_s": 120,
  "ssh_timeout_s": 45,
  "opencode_auth_path": "~/.local/share/opencode/auth.json",
  "grok_auth_path": "~/.grok/auth.json",
  "codex_auth_path": "~/.codex/auth.json",
  "kimi_usage_url": "https://api.kimi.ai/coding/v1/usages",
  "quota_timeout_s": 10,
  "quota_refresh_min_interval_s": 30,
  "quota_stale_after_s": 3600,
  "allow_self_update": false,
  "update_repo": "critfusion/critboard",
  "update_branch": "main",
  "update_check_min_interval_s": 300,
  "ssh_opts": [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=10",
    "-o", "StrictHostKeyChecking=accept-new"
  ]
}
